server {
    listen 80;
    server_name ${EDITOR_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${EDITOR_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${EDITOR_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${EDITOR_DOMAIN}/privkey.pem;

    set $editor_path "${EDITOR_PATH}";
    set $is_editor_path 0;

    if ($uri = $editor_path) {
        return 308 $editor_path/$is_args$args;
    }

    if ($uri ~ ^${EDITOR_PATH}/) {
        set $is_editor_path 1;
    }

    if ($is_editor_path = 0) {
        return 404;
    }

    rewrite ^${EDITOR_PATH}(/.*)$ $1 break;

    location / {
        proxy_pass http://web-editor:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
