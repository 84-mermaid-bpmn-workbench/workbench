server {
    listen 80;
    server_name _;

    set $editor_path "${EDITOR_PATH}";
    set $is_editor_path 0;

    if ($uri = $editor_path) {
        return 308 $editor_path/$is_args$args;
    }

    if ($uri ~ ^${EDITOR_PATH}/) {
        set $is_editor_path 1;
    }

    if ($is_editor_path = 0) {
        return 404;
    }

    rewrite ^${EDITOR_PATH}(/.*)$ $1 break;

    location / {
        proxy_pass http://web-editor:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
