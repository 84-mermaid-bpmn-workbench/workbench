{
    "name": "mermaid-bpmn-cli",
    "version": "0.0.1",
    "description": "Render Mermaid-BPMN source to SVG locally.",
    "keywords": [
        "mermaid",
        "bpmn",
        "svg",
        "diagram",
        "cli",
        "architecture",
        "design",
        "business process",
        "ddd",
        "microservices"
    ],
    "author": {
        "name": "Valentine Shimanovsky",
        "email": "valentineshi.dev@gmail.com"
    },
    "homepage": "https://github.com/84-mermaid-bpmn-workbench/workbench/tree/master/cli#readme",
    "bugs": "https://github.com/84-mermaid-bpmn-workbench/workbench/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/84-mermaid-bpmn-workbench/workbench.git",
        "directory": "cli"
    },
    "type": "module",
    "license": "MIT",
    "bin": {
        "mermaid-bpmn-cli": ".delivery/.builds/dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./.delivery/.builds/dist/index.d.ts",
            "import": "./.delivery/.builds/dist/index.js"
        }
    },
    "scripts": {
        "test:foundation": "npm run vitest",
        "vitest": "vitest run --config tests/.ancillary/config/vitest.config.ts",
        "test:e2e": "npm run build && npm run vitest:e2e",
        "vitest:e2e": "vitest run --mode e2e --config tests/.ancillary/config/vitest.config.ts",
        "check-types": "npx tsc --noEmit",
        "lint": "eslint .",
        "build": "tsx .delivery/scripts/build.ts --target=all",
        "build:browser": "tsx .delivery/scripts/build.ts --target=browser",
        "build:node": "tsx .delivery/scripts/build.ts --target=node",
        "clean": "tsx .delivery/scripts/build.ts --target=clean",
        "release:check": "tsx .delivery/scripts/release-check.ts",
        "release:prepare": "tsx .delivery/scripts/release.ts prepare"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "files": [
        ".delivery/.builds/dist",
        "THIRD-PARTY-NOTICES.md"
    ],
    "dependencies": {
        "@iconify-json/devicon-plain": "1.2.61",
        "@iconify-json/fa7-brands": "1.2.4",
        "@iconify-json/fa7-regular": "1.2.3",
        "@iconify-json/lucide": "1.2.139",
        "@iconify-json/mdi": "1.2.3",
        "@iconify-json/nonicons": "1.2.2",
        "commander": "^15.0.0",
        "mermaid": "11.17.2",
        "mermaid-bpmn": "1.2.0",
        "puppeteer-core": "25.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^4.1.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "prettier": "^3.8.4",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "katex": "0.18.2"
    }
}
