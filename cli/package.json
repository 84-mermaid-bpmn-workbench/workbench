{
    "name": "mermaid-bpmn-cli",
    "version": "0.1.0",
    "description": "Render Mermaid-BPMN source to SVG locally.",
    "type": "module",
    "license": "MIT",
    "bin": {
        "mermaid-bpmn-cli": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/render-svg.d.ts",
            "import": "./dist/render-svg.js"
        }
    },
    "scripts": {
        "test:foundation": "npm run vitest",
        "vitest": "vitest run --config tests/foundation/.ancillary/config/vitest.config.ts",
        "check-types": "npx tsc --noEmit",
        "lint": "eslint .",
        "build": "npm run build:node && npm run build:browser",
        "build:browser": "node .delivery/scripts/build-browser.mjs",
        "build:node": "npx tsc"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@iconify-json/devicon-plain": "1.2.61",
        "@iconify-json/fa7-brands": "1.2.4",
        "@iconify-json/fa7-regular": "1.2.3",
        "@iconify-json/lucide": "1.2.139",
        "@iconify-json/mdi": "1.2.3",
        "@iconify-json/nonicons": "1.2.2",
        "commander": "^15.0.0",
        "mermaid": "11.17.2",
        "mermaid-bpmn": "1.2.0",
        "puppeteer-core": "25.12.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.4",
        "@vitest/coverage-v8": "^4.1.11",
        "esbuild": "^0.28.2",
        "eslint": "^10.10.0",
        "prettier": "^3.8.4",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^4.1.9"
    },
    "overrides": {
        "katex": "0.18.2"
    }
}
