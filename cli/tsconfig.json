{
    "compilerOptions": {
        "tsBuildInfoFile": "./.delivery/.temp/tsconfig.tsbuildinfo",
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "incremental": true,
        "rootDir": ".",
        "outDir": "./.delivery/.builds/dist",
        "declaration": true,
        "resolveJsonModule": true,
        "paths": {
            "@src/*": ["./src/*"],
            "@tests/*": ["./tests/*"],
            "@fixtures/*": ["./tests/.ancillary/fixtures/*"]
        }
    },
    "include": ["./src", "./eslint.config.mjs", "*.d.ts", "./tests/**/*.ts", "tests/.ancillary/**/*.*"],
    "exclude": ["./.delivery/**", "./node_modules/**", ".coverage"]
}
